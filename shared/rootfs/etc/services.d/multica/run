#!/command/with-contenv bash
# Multica daemon (optional: needs multica_token or stored credentials).
# Configures provider auth for the Claude / Cursor / Pi runtimes, updates the
# agent CLIs once per container start, then runs
# `multica daemon start --foreground`. (The RW auto-stop timer is its own
# service: services.d/auto-stop/run.)
#
# Restart policy: config/auth failure (exit 78), no Multica credentials
# (parked) or a clean daemon exit -> stay down; daemon crash, or any other
# unplanned exit (e.g. a `set -e` abort during setup) -> restart after 3s.
set -euo pipefail
# shellcheck source=/dev/null
source /usr/lib/agent-host/common.sh

# Permanent configuration / auth failures: the service stays down.
readonly EX_CONFIG=78

OPTIONS_FILE="${MULTICA_OPTIONS_FILE:-/data/options.json}"
ACCESS_MODE="${MULTICA_ACCESS_MODE:-rw}"
DEFAULT_RUNTIME_NAME="${MULTICA_DEFAULT_RUNTIME_NAME:-}"

# Export early so ha-publish-status / die_config hit the correct entity id.
export MULTICA_ACCESS_MODE="${ACCESS_MODE}"
export HOME="/data"
export XDG_CONFIG_HOME="/data/.config"
export XDG_DATA_HOME="/data/.local/share"
export XDG_CACHE_HOME="/data/.cache"
# HA add-on containers run as root; Claude Code blocks bypassPermissions unless
# it knows we are in a sandbox/container (see anthropics/claude-code#9184).
export IS_SANDBOX=1

export PATH="/data/bin:/data/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH}"

if [[ "${MULTICA_RUN_LIB:-}" != "1" ]]; then
  mkdir -p "${HOME}" "${XDG_CONFIG_HOME}" "${XDG_DATA_HOME}" "${XDG_CACHE_HOME}" \
    /data/.multica /data/.claude /data/bin /data/workspace /data/.pi/agent \
    /data/.local/bin /data/.local/share
fi

log() {
  local level="$1"; shift
  echo "[multica-${ACCESS_MODE}] ${level}: $*"
}

publish_status() {
  # Best-effort; ha-publish-status never fails the boot path.
  if command -v ha-publish-status >/dev/null 2>&1; then
    ha-publish-status "$@" || true
  fi
}

die_config() {
  log error "$*"
  publish_status error "$*"
  ah_stay_down multica
  exit "${EX_CONFIG}"
}

option() {
  local key="$1"
  local default="${2:-}"
  if [[ -f "${OPTIONS_FILE}" ]]; then
    jq -r --arg key "${key}" --arg default "${default}" \
      '.[$key] // $default | if . == null then $default else tostring end' \
      "${OPTIONS_FILE}"
  else
    printf '%s' "${default}"
  fi
}

option_or_default() {
  local key="$1"
  local packaged_default="$2"
  local value
  value="$(option "${key}" "")"
  if [[ -z "${value// }" ]]; then
    printf '%s' "${packaged_default}"
  else
    printf '%s' "${value}"
  fi
}

# `multica auth status` exits 0 even when it prints "Not authenticated"
# (multica 0.4.15), so the exit code alone cannot be trusted.
multica_has_stored_credentials() {
  local out
  out="$(multica auth status 2>&1)" || return 1
  ! grep -qi 'not authenticated' <<<"${out}"
}

write_agent_context() {
  local access_label share_access media_access local_dir_hint auto_stop_section stop_minutes
  auto_stop_section=""
  if [[ "${ACCESS_MODE}" == "ro" ]]; then
    access_label="read-only"
    share_access="read-only"
    media_access="read-only"
    local_dir_hint="/workspace (writable). Read HA config from /config (read-only)."
  else
    access_label="read-write"
    share_access="read-write"
    media_access="read-write"
    local_dir_hint="/config (HA config, writable) or /workspace (agent scratch)."
    stop_minutes="$(option auto_stop_minutes "0")"
    if [[ "${stop_minutes}" =~ ^[0-9]+$ ]] && [[ "${stop_minutes}" -gt 0 ]]; then
      auto_stop_section="
## Write access lifetime

This add-on stops itself about ${stop_minutes} minutes after start (\`auto_stop_minutes\`). In-progress tasks end when it stops. Set the option to 0 to leave it running. 0 is the default.
"
    else
      auto_stop_section="
## Write access lifetime

This add-on stays on until you stop it. \`auto_stop_minutes\` defaults to 0. Set it to 30 on the read-write add-on to turn that container off 30 minutes after start.
"
    fi
  fi

  cat >/data/HA_AGENT_CONTEXT.md <<EOF
# Home Assistant Multica context (${access_label})

This container runs Multica with Claude Code, Cursor Agent, and Pi CLIs.

## Filesystem

| Path | Access | Purpose |
|------|--------|---------|
| \`/config\` | ${access_label} | Home Assistant configuration |
| \`/workspace\` | read-write | Multica agent workdirs / scratch (persisted in \`/data/workspace\`) |
| \`/share\` | ${share_access} | Shared HA storage |
| \`/media\` | ${media_access} | Media files |
| \`/data\` | read-write | Daemon credentials + tool state |

**Recommended Multica \`local_directory\`:** ${local_dir_hint}

## Runtimes

- \`claude\` — Claude Code (subscription/API via add-on options)
- \`cursor-agent\` — Cursor Agent CLI (Cursor plan via \`cursor_api_key\`)
- \`pi\` — Pi coding agent (OpenRouter via \`pi_openrouter_api_key\`)

On container start, before the daemon launches, the add-on tries once to update Multica, Claude, Cursor, and Pi. Copies live on \`/data\`. If the image binary is newer, that one is kept. A failed download does not hide it, and the daemon still starts. A daemon crash does not run the update again until the container itself restarts.

## Home Assistant API

\`\`\`bash
ha-states
ha-history sensor.temperature
ha-api GET /states
\`\`\`

Filesystem mode is \`${ACCESS_MODE}\`. \`ha-api\` blocks non-GET when RO; \`SUPERVISOR_TOKEN\` still allows Core API calls via raw curl.

This add-on publishes lifecycle status to \`sensor.multica_daemon_${ACCESS_MODE}_status\` (\`starting\` → \`authenticated\` → \`ready\` / \`error\` / \`disabled\`) via \`ha-publish-status\`.

Claude Code Remote Control runs beside the daemon as its own service with a separate HOME (\`/data/remote-control\`); do not reuse its login here.
${auto_stop_section}
Environment: \`HA_URL\`, \`HA_TOKEN\`/\`SUPERVISOR_TOKEN\`, \`MULTICA_ACCESS_MODE\`, \`MULTICA_HA_CONFIG=/config\`, \`MULTICA_WORKSPACE=/workspace\`
EOF
}

configure_provider_auth() {
  local anthropic_key cursor_key openrouter_key openrouter_model claude_oauth
  anthropic_key="$(option claude_api_key "")"
  claude_oauth="$(option claude_code_oauth_token "")"
  cursor_key="$(option cursor_api_key "")"
  openrouter_key="$(option pi_openrouter_api_key "")"
  openrouter_model="$(option pi_openrouter_model "anthropic/claude-sonnet-4")"

  # Claude Code auth: API key bills Console/API usage; OAuth token uses Pro/Max
  # subscription limits. API key wins if both are set — prefer subscription when
  # the OAuth token option is provided.
  if [[ -n "${claude_oauth}" ]]; then
    export CLAUDE_CODE_OAUTH_TOKEN="${claude_oauth}"
    unset ANTHROPIC_API_KEY || true
    unset ANTHROPIC_AUTH_TOKEN || true
    if [[ -n "${anthropic_key}" ]]; then
      log warning "claude_code_oauth_token set — ignoring claude_api_key so Pro/Max subscription is used (API key would take precedence)"
    else
      log info "CLAUDE_CODE_OAUTH_TOKEN set for Claude Code (Pro/Max subscription)"
    fi
  elif [[ -n "${anthropic_key}" ]]; then
    export ANTHROPIC_API_KEY="${anthropic_key}"
    log info "ANTHROPIC_API_KEY set for Claude Code (API / Console billing)"
  else
    log info "No Claude credentials in options — using existing /data/.claude login if present"
  fi

  if [[ -n "${cursor_key}" ]]; then
    export CURSOR_API_KEY="${cursor_key}"
    log info "CURSOR_API_KEY set for Cursor Agent (plan auth)"
  else
    log info "No cursor_api_key — Cursor Agent will not authenticate until set"
  fi

  if [[ -n "${openrouter_key}" ]]; then
    export OPENROUTER_API_KEY="${openrouter_key}"
    mkdir -p /data/.pi/agent
    jq -n --arg key "${openrouter_key}" \
      '{openrouter: {type: "api_key", key: $key}}' > /data/.pi/agent/auth.json
    jq -n --arg model "${openrouter_model}" \
      '{defaultProvider: "openrouter", defaultModel: $model}' > /data/.pi/agent/settings.json
    chmod 600 /data/.pi/agent/auth.json
    log info "Pi configured for OpenRouter (model=${openrouter_model})"
  else
    log info "No pi_openrouter_api_key — Pi OpenRouter auth not configured"
  fi
}

# /run is cleared when the container stops, and kept when s6 restarts this
# service after a daemon crash. One update pass per container start. Also runs
# when the daemon is parked (no multica_token): Remote Control and the Cursor
# worker use the same /data CLIs and would otherwise never be refreshed.
run_boot_update() {
  if [[ -e /run/boot-update.done ]]; then
    log info "Skipping harness update; this container already ran it"
    return 0
  fi
  publish_status starting "Updating agent CLIs"
  log info "Updating Multica, Claude, Cursor, and Pi"
  if [[ -x /usr/bin/update-agent-tools ]]; then
    /usr/bin/update-agent-tools || log warning "agent CLI update failed; starting with the copies already on disk"
  else
    log warning "update-agent-tools missing; starting with image CLIs"
  fi
  touch /run/boot-update.done || log warning "could not record boot update marker"
  hash -r || true
}

# Tests source this file with MULTICA_RUN_LIB=1 and stop before boot.
if [[ "${MULTICA_RUN_LIB:-}" == "1" ]]; then
  return 0 2>/dev/null || exit 0
fi

# Unplanned exits (a `set -e` abort during setup) get the same 3s delay as a
# daemon crash instead of s6's 1s retry. Planned exits are 0 and 78 (stay
# down), 143/130 (add-on stopping), or already delayed by ah_restart_after.
trap 'rc=$?; case "${rc}" in 0|78|130|143) ;; *) [[ -n "${AH_RESTART_DELAYED:-}" ]] || ah_restart_after multica "" 3 "${rc}" ;; esac' EXIT


if [[ ! -d /config ]]; then
  die_config "Home Assistant config is not mounted at /config"
fi

export HA_URL="${HA_URL:-http://supervisor/core/api}"
export HA_TOKEN="${SUPERVISOR_TOKEN:-}"
export MULTICA_HA_CONFIG="/config"
export MULTICA_WORKSPACE="/workspace"
export MULTICA_ACCESS_MODE="${ACCESS_MODE}"

publish_status starting "Bootstrapping Multica daemon"

MULTICA_TOKEN="$(option multica_token "")"
SERVER_URL="$(option multica_server_url "https://api.multica.ai")"
APP_URL="$(option multica_app_url "https://multica.ai")"
WORKSPACE_ID="$(option multica_workspace_id "")"
# Always carries the access mode (e.g. "HA Agent Host (RO)") — see agent-host-name.
DEVICE_NAME="$(agent-host-name display "$(option multica_device_name "")")"
RUNTIME_NAME="$(option_or_default multica_runtime_name "${DEFAULT_RUNTIME_NAME}")"
MAX_TASKS="$(option multica_max_concurrent_tasks "2")"

export MULTICA_DAEMON_DEVICE_NAME="${DEVICE_NAME}"
export MULTICA_DAEMON_MAX_CONCURRENT_TASKS="${MAX_TASKS}"
if [[ -n "${RUNTIME_NAME}" ]]; then
  export MULTICA_AGENT_RUNTIME_NAME="${RUNTIME_NAME}"
fi

configure_provider_auth
write_agent_context

if ! command -v multica >/dev/null; then
  die_config "multica CLI missing from image"
fi

log info "Configuring Multica CLI (server=${SERVER_URL})"
mkdir -p /data/.multica
if [[ ! -f /data/.multica/config.json ]]; then
  printf '%s\n' '{}' > /data/.multica/config.json
fi

tmp="$(mktemp)"
jq \
  --arg server_url "${SERVER_URL}" \
  --arg app_url "${APP_URL}" \
  --arg device_name "${DEVICE_NAME}" \
  --argjson max_tasks "${MAX_TASKS}" \
  '.server_url = $server_url
   | .app_url = $app_url
   | .device_name = $device_name
   | .max_concurrent_tasks = $max_tasks' \
  /data/.multica/config.json >"${tmp}"
mv "${tmp}" /data/.multica/config.json

if [[ -n "${RUNTIME_NAME}" ]]; then
  tmp="$(mktemp)"
  jq --arg name "${RUNTIME_NAME}" '.runtime_name = $name' /data/.multica/config.json >"${tmp}"
  mv "${tmp}" /data/.multica/config.json
fi

if [[ -n "${WORKSPACE_ID}" ]]; then
  tmp="$(mktemp)"
  jq --arg id "${WORKSPACE_ID}" '.workspace_id = $id' /data/.multica/config.json >"${tmp}"
  mv "${tmp}" /data/.multica/config.json
fi

if [[ -n "${MULTICA_TOKEN}" ]]; then
  log info "Authenticating with Multica personal access token from add-on options"
  if ! multica login --token "${MULTICA_TOKEN}"; then
    die_config "multica login failed — check the Multica token option"
  fi
elif multica_has_stored_credentials; then
  log info "Using existing Multica credentials stored in /data"
else
  # Multica is optional in Agent Host: park the daemon (it stays down, see the
  # end of this branch) and leave Remote Control / Cursor worker running.
  log info "No multica_token and no stored Multica credentials — Multica daemon not started (set multica_token to enable it)"
  # The CLI update still runs: Remote Control and the Cursor worker use the
  # same /data CLIs.
  run_boot_update
  publish_status disabled "No multica_token configured"
  ah_stay_down multica
  exit 0
fi

publish_status authenticated "Multica credentials OK"

if [[ -n "${WORKSPACE_ID}" ]]; then
  multica workspace switch "${WORKSPACE_ID}" >/dev/null 2>&1 || \
    log warning "Could not switch workspace to ${WORKSPACE_ID}"
fi

run_boot_update

for tool in claude cursor-agent pi; do
  if command -v "${tool}" >/dev/null; then
    log info "runtime tool present: ${tool} ($(${tool} --version 2>/dev/null | head -1 || echo ok))"
  else
    log warning "runtime tool missing: ${tool}"
  fi
done

DAEMON_ARGS=(
  daemon start --foreground
  --device-name "${DEVICE_NAME}"
  --max-concurrent-tasks "${MAX_TASKS}"
)
if [[ -n "${RUNTIME_NAME}" ]]; then
  DAEMON_ARGS+=(--runtime-name "${RUNTIME_NAME}")
fi

log info "Starting Multica daemon (access=${ACCESS_MODE}, device=${DEVICE_NAME})"
log info "HA config: /config (${ACCESS_MODE}) | agent workspace: /workspace (rw) | HA API: ${HA_URL}"
# Best “setup finished” signal from bash alone — true heartbeat readiness would
# need a hook inside the daemon.
publish_status ready "Starting Multica daemon"
rc=0
ah_run multica "${DAEMON_ARGS[@]}" || rc=$?
if [[ "${rc}" -eq 0 || "${rc}" -eq "${EX_CONFIG}" ]]; then
  log info "daemon exited (${rc}); not restarting — fix add-on options and restart the add-on"
  ah_stay_down multica
  exit "${rc}"
fi
ah_restart_after multica "" 3 "${rc}"
