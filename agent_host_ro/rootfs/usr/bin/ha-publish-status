#!/usr/bin/env bash
# Publish Agent Host component lifecycle status to Home Assistant Core.
# Allowed in both RO and RW add-ons (bypasses ha-api's RO write block).
# Usage: [STATUS_COMPONENT=daemon|remote_control|cursor_worker] ha-publish-status STATE [message]
# States: starting | authenticated | waiting_for_login | ready | error | disabled | stopped
set -euo pipefail

STATE="${1:-}"
MESSAGE="${2:-}"

if [[ -z "${STATE}" ]]; then
  echo "Usage: ha-publish-status STATE [message]" >&2
  echo "  ha-publish-status starting" >&2
  echo "  ha-publish-status ready" >&2
  exit 2
fi

ACCESS_MODE="${MULTICA_ACCESS_MODE:-rw}"
case "${ACCESS_MODE}" in
  ro) MODE=ro; MODE_LABEL=RO ;;
  *) MODE=rw; MODE_LABEL=RW ;;
esac

# Entity ids keep the historical sensor.multica_daemon_<mode>_status for the
# daemon so existing automations keep working.
COMPONENT="${STATUS_COMPONENT:-daemon}"
case "${COMPONENT}" in
  remote_control)
    ENTITY_ID="sensor.claude_remote_control_${MODE}_status"
    FRIENDLY_NAME="Claude Remote Control ${MODE_LABEL} Status"
    ;;
  cursor_worker)
    ENTITY_ID="sensor.cursor_worker_${MODE}_status"
    FRIENDLY_NAME="Cursor Worker ${MODE_LABEL} Status"
    ;;
  *)
    COMPONENT=daemon
    ENTITY_ID="sensor.multica_daemon_${MODE}_status"
    FRIENDLY_NAME="Multica Daemon ${MODE_LABEL} Status"
    ;;
esac

case "${STATE}" in
  starting) ICON="mdi:timer-sand" ;;
  authenticated) ICON="mdi:key-check" ;;
  waiting_for_login) ICON="mdi:account-key" ;;
  disabled) ICON="mdi:minus-circle-outline" ;;
  ready) ICON="mdi:check-circle" ;;
  error) ICON="mdi:alert-circle" ;;
  stopped) ICON="mdi:stop-circle" ;;
  *) ICON="mdi:robot" ;;
esac

TOKEN="${HA_TOKEN:-${SUPERVISOR_TOKEN:-}}"
BASE="${HA_URL:-http://supervisor/core/api}"
BASE="${BASE%/}"

BODY="$(
  jq -n \
    --arg state "${STATE}" \
    --arg friendly_name "${FRIENDLY_NAME}" \
    --arg icon "${ICON}" \
    --arg access_mode "${ACCESS_MODE}" \
    --arg component "${COMPONENT}" \
    --arg message "${MESSAGE}" \
    '{
      state: $state,
      attributes: (
        {
          friendly_name: $friendly_name,
          icon: $icon,
          access_mode: $access_mode,
          component: $component
        }
        + (if $message == "" then {} else {message: $message} end)
      )
    }'
)"

# /run is cleared when the container stops. The keepalive service reads this
# after a Core restart, which deletes states posted to /api/states.
STATUS_DIR=/run/agent-host-status
mkdir -p "${STATUS_DIR}"
saved="$(mktemp "${STATUS_DIR}/.tmp.XXXXXX")"
if jq -n --arg entity_id "${ENTITY_ID}" --argjson body "${BODY}" \
  '{entity_id: $entity_id, body: $body}' >"${saved}"; then
  mv -f "${saved}" "${STATUS_DIR}/${COMPONENT}.json"
else
  rm -f "${saved}"
fi

if [[ -z "${TOKEN}" ]]; then
  echo "ha-publish-status: SUPERVISOR_TOKEN / HA_TOKEN is not set; skipping (${STATE})" >&2
  exit 0
fi

if curl -fsS \
  --max-time 10 \
  -X POST \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  -d "${BODY}" \
  "${BASE}/states/${ENTITY_ID}" >/dev/null; then
  echo "ha-publish-status: ${ENTITY_ID}=${STATE}" >&2
else
  # Never fail boot because status publish failed.
  echo "ha-publish-status: failed to set ${ENTITY_ID}=${STATE}" >&2
fi

exit 0
