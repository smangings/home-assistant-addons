#!/command/with-contenv bash
# Claude Code Remote Control for this add-on.
# Waits until a claude.ai login exists in the isolated HOME, then runs
# `claude remote-control` in the configured directory.
#
# Restart policy: disabled -> stay down; any exit -> restart after 10s
# (back to waiting for a login if it expired).
set -uo pipefail
# shellcheck source=/dev/null
source /usr/lib/agent-host/common.sh
SVC=remote-control
COMPONENT=remote_control
log() { echo "[${SVC}] $*"; }

# `claude remote-control` redraws its status panel (a "·✔︎· Connected …" line
# plus a few detail lines) about once a second, even with no terminal, which
# floods the add-on log. Print each panel only when it differs from the last
# one printed. Timestamped event lines ("[18:31:31] …") pass straight through.
print_status_changes() {
  local line panel="" last_panel=""
  flush_panel() {
    if [[ -n "${panel}" && "${panel}" != "${last_panel}" ]]; then
      printf '%s\n' "${panel}"
      last_panel="${panel}"
    fi
    panel=""
  }
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" == "·"* ]]; then        # a new status panel starts
      flush_panel
      panel="${line}"
    elif [[ "${line}" == "["* || -z "${panel}" ]]; then  # event line
      flush_panel
      printf '%s\n' "${line}"
    else                                     # rest of the current panel
      panel+=$'\n'"${line}"
    fi
  done
  flush_panel
}

rc_env

if ! ah_bool claude_remote_control true; then
  log "disabled (claude_remote_control: false)"
  ah_publish "${COMPONENT}" disabled "claude_remote_control option is off"
  ah_stay_down "${SVC}"
  exit 0
fi

name="$(rc_name)"
dir="$(rc_directory)"
perm="$(ah_option claude_remote_control_permission_mode default)"
claude-rc-seed "${dir}" || log "warning: could not seed ${HOME}/.claude.json"

if ! rc_login_ready; then
  log "No claude.ai login yet. Open the Agent Host sidebar panel in Home Assistant"
  log "(it offers the sign-in), or run: claude-rc-login"
  ah_publish "${COMPONENT}" waiting_for_login "Open the Agent Host panel and sign in"
  until rc_login_ready; do
    sleep 15 & wait $!
  done
  log "login found"
fi

args=(remote-control --name "${name}" --spawn same-dir)
if [[ "${perm}" != "default" ]]; then
  args+=(--permission-mode "${perm}")
fi

cd "${dir}" || exit 1
log "starting as \"${name}\" in ${dir} (permission mode: ${perm}, claude $(claude --version 2>/dev/null | head -1))"
ah_publish "${COMPONENT}" ready "Remote Control \"${name}\" in ${dir}"
# Strip terminal escape codes and carriage returns so identical panels compare
# equal.
ah_run claude "${args[@]}" \
  > >(sed -u -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r$//' | print_status_changes)
ah_restart_after "${SVC}" "${COMPONENT}" 10 $?
