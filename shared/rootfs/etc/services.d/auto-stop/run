#!/command/with-contenv bash
# Stop the read-write add-on after auto_stop_minutes (default 30).
# The read-only add-on ships this service too (shared rootfs) and leaves it idle.
# A Supervisor stop keeps the add-on off, including when Watchdog is enabled.
# Container shutdown must not fall through into that stop call.
set -euo pipefail

OPTIONS_FILE="${MULTICA_OPTIONS_FILE:-/data/options.json}"
SLEEP_PID=""

log() {
  echo "[multica-auto-stop] $*"
}

# Prints the configured window in minutes. 0 means disabled.
# Missing or invalid values fall back to 30.
resolve_auto_stop_minutes() {
  local parsed="30"
  if [[ -f "${OPTIONS_FILE}" ]]; then
    parsed="$(jq -r '.auto_stop_minutes // 30' "${OPTIONS_FILE}" 2>/dev/null || echo 30)"
  fi
  if [[ ! "${parsed}" =~ ^[0-9]+$ ]]; then
    echo 30
    return 0
  fi
  echo "${parsed}"
}

idle_forever() {
  if [[ $# -gt 0 ]]; then
    log "info: $*"
  fi
  if [[ "${MULTICA_AUTO_STOP_EXIT_WHEN_IDLE:-}" == "1" ]]; then
    exit 0
  fi
  exec sleep infinity
}

# Returns 0 when the sleep finished, non-zero when it was interrupted.
interruptible_sleep() {
  local duration="$1"
  local status
  sleep "${duration}" &
  SLEEP_PID=$!
  set +e
  wait "${SLEEP_PID}"
  status=$?
  set -e
  SLEEP_PID=""
  return "${status}"
}

on_term() {
  log "info: auto-stop cancelled"
  if [[ -n "${SLEEP_PID}" ]]; then
    kill "${SLEEP_PID}" 2>/dev/null || true
    wait "${SLEEP_PID}" 2>/dev/null || true
  fi
  exit 0
}

publish() {
  if command -v ha-publish-status >/dev/null 2>&1; then
    ha-publish-status "$@" || true
  fi
}

request_supervisor_stop() {
  local attempt=1
  local delay=15
  local told_error=0
  while true; do
    if curl -fsS --max-time 30 -X POST \
      -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
      -o /dev/null \
      http://supervisor/addons/self/stop; then
      log "info: Supervisor accepted stop"
      return 0
    fi
    log "warning: Supervisor stop failed (attempt ${attempt})"
    if [[ "${told_error}" -eq 0 ]]; then
      publish error "Auto-stop failed; will keep retrying"
      told_error=1
    fi
    if [[ "${attempt}" -eq 5 ]]; then
      log "warning: still unable to stop; retrying once a minute"
      delay=60
    fi
    attempt=$((attempt + 1))
    if ! interruptible_sleep "${delay}"; then
      log "info: auto-stop interrupted during stop retry"
      exit 0
    fi
  done
}

main() {
  trap on_term TERM INT

  if [[ "${MULTICA_ACCESS_MODE:-}" != "rw" ]]; then
    idle_forever
  fi

  local minutes seconds deadline
  minutes="$(resolve_auto_stop_minutes)"
  if [[ "${minutes}" -eq 0 ]]; then
    idle_forever "auto-stop disabled (auto_stop_minutes=0)"
  fi

  seconds=$((minutes * 60))
  if [[ "${MULTICA_AUTO_STOP_SECONDS:-}" =~ ^[0-9]+$ ]]; then
    seconds="${MULTICA_AUTO_STOP_SECONDS}"
  fi

  deadline="$(date -d "+${seconds} seconds" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || true)"
  log "info: write-access add-on will stop in ${minutes} minutes${deadline:+ at ${deadline}}"

  if ! interruptible_sleep "${seconds}"; then
    log "info: auto-stop interrupted; not stopping"
    exit 0
  fi

  log "info: auto-stop reached (${minutes} minutes); stopping add-on"
  publish stopped "Auto-stopped after ${minutes} minutes"

  if [[ -z "${SUPERVISOR_TOKEN:-}" ]]; then
    log "error: SUPERVISOR_TOKEN is not set; add-on was not stopped"
    publish error "Auto-stop failed: SUPERVISOR_TOKEN missing"
    idle_forever
  fi

  request_supervisor_stop
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main
fi
