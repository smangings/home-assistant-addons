#!/command/with-contenv bash
# Ingress web terminal: ttyd -> tmux -> claude-rc-terminal.
# ttyd only listens on a unix socket; Caddy (services.d/caddy) is the sole
# TCP listener and only admits the Supervisor ingress proxy. tmux keeps a
# login in progress alive if the browser panel is closed and reopened.
#
# Restart policy: any exit -> restart after 5s.
set -uo pipefail
# shellcheck source=/dev/null
source /usr/lib/agent-host/common.sh

rm -f /run/ttyd.sock
ah_run ttyd \
  --writable \
  --interface /run/ttyd.sock \
  --ping-interval 30 \
  --max-clients 4 \
  --terminal-type xterm-256color \
  --client-option titleFixed="Agent Host $(ah_mode_label)" \
  tmux -u new-session -A -s agent-host /usr/bin/claude-rc-terminal
ah_restart_after terminal "" 5 $?
