#!/command/with-contenv bash
# s6 longrun: ingress gate in front of ttyd (allow 172.30.32.2 only).
# shellcheck source=/dev/null
source /usr/lib/agent-host/common.sh
ah_backoff caddy "" 5
# Keep Caddy's state dirs out of /data (nothing to persist: no admin API,
# no certificates, no autosaved config).
export XDG_CONFIG_HOME=/tmp/caddy/config XDG_DATA_HOME=/tmp/caddy/data
exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
