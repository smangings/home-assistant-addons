#!/usr/bin/env bash
# Try to refresh Multica, Claude Code, Cursor Agent, and Pi.
# Called from /run.sh before the daemon starts. Failures are logged, not fatal.
# Each step is time-bounded. Installs land on /data so they survive a container recreate.
set -u

log() { echo "[boot-update] $*"; }

ARCH_RAW="$(uname -m)"
case "${ARCH_RAW}" in
  x86_64|amd64) CLAUDE_PLATFORM="linux-x64"; MULTICA_ARCH="amd64" ;;
  aarch64|arm64) CLAUDE_PLATFORM="linux-arm64"; MULTICA_ARCH="arm64" ;;
  *) log "unsupported arch ${ARCH_RAW}"; exit 0 ;;
esac

PI_PREFIX="/data/.local"
export PATH="/data/bin:${PI_PREFIX}/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"

mkdir -p /data/bin "${PI_PREFIX}/bin" /data/.npm /data/.cache /usr/local/bin

# Bound network/install steps so a hang cannot block the daemon forever.
# Exit 124 from GNU timeout means the deadline was hit.
run_timeout() {
  local secs="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout --signal=TERM --kill-after=30s "${secs}" "$@"
    return $?
  fi
  "$@"
  return $?
}

explain_rc() {
  local rc="$1"
  case "${rc}" in
    0) echo "ok" ;;
    124) echo "timed out (GNU timeout exit 124)" ;;
    137) echo "killed SIGKILL (often OOM or kill-after)" ;;
    143) echo "terminated SIGTERM" ;;
    *) echo "exit ${rc}" ;;
  esac
}

log_df() {
  local line
  while IFS= read -r line; do
    log "df: ${line}"
  done < <(df -h /data / /usr/local 2>/dev/null || df -h /data / 2>/dev/null || true)
}

tail_npm_log() {
  local latest lines
  latest="$(ls -t /data/.npm/_logs/*-debug-*.log 2>/dev/null | head -1 || true)"
  if [[ -z "${latest}" ]]; then
    log "no npm debug log under /data/.npm/_logs"
    return 0
  fi
  log "npm debug log: ${latest}"
  lines="$(tail -n 60 "${latest}" 2>/dev/null || true)"
  if [[ -n "${lines}" ]]; then
    log "----- npm log tail -----"
    while IFS= read -r line; do
      log "npm: ${line}"
    done <<<"${lines}"
    log "----- end npm log -----"
  fi
}

latest_multica_version() {
  local url
  url="$(run_timeout 60 curl -fsSL -o /dev/null -w '%{url_effective}' https://github.com/multica-ai/multica/releases/latest)" || return 1
  url="${url##*/}"
  url="${url#v}"
  [[ "${url}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s' "${url}"
}

multica_installed_version() {
  local bin=""
  if [[ -x /data/bin/multica ]]; then
    bin=/data/bin/multica
  elif command -v multica >/dev/null 2>&1; then
    bin="$(command -v multica)"
  else
    return 0
  fi
  run_timeout 20 "${bin}" version 2>/dev/null | awk 'NR==1 { print $2; exit }'
}

claude_installed_version() {
  local bin=""
  if [[ -x /data/bin/claude ]]; then
    bin=/data/bin/claude
  elif command -v claude >/dev/null 2>&1; then
    bin="$(command -v claude)"
  else
    return 0
  fi
  run_timeout 20 "${bin}" --version 2>/dev/null | awk 'NR==1 { print $1; exit }'
}

pi_prefix_version() {
  local pkg="${PI_PREFIX}/lib/node_modules/@earendil-works/pi-coding-agent/package.json"
  [[ -f "${pkg}" ]] || return 0
  jq -r '.version // empty' "${pkg}" 2>/dev/null || true
}

link_pi() {
  if [[ -x "${PI_PREFIX}/bin/pi" ]]; then
    ln -sfn "${PI_PREFIX}/bin/pi" /data/bin/pi
  fi
}

update_multica() {
  log "Updating Multica CLI…"
  local version installed tgz tmp rc expected
  version="$(latest_multica_version || true)"
  if [[ -z "${version}" ]]; then
    log "could not resolve Multica latest version"
    return 0
  fi
  installed="$(multica_installed_version || true)"
  log "Multica installed=${installed:-none} latest=${version}"
  if [[ -n "${installed}" && "${installed}" == "${version}" ]]; then
    log "Multica already at ${installed}; skip"
    return 0
  fi

  tgz="multica-cli-${version}-linux-${MULTICA_ARCH}.tar.gz"
  tmp="$(mktemp -d)"
  if ! run_timeout 60 curl -fsSL \
      "https://github.com/multica-ai/multica/releases/download/v${version}/checksums.txt" \
      -o "${tmp}/checksums.txt"; then
    log "Multica checksums download failed"
    rm -rf "${tmp}"
    return 0
  fi
  log "Multica download ${version} (timeout 180s)…"
  run_timeout 180 curl -fsSL \
    "https://github.com/multica-ai/multica/releases/download/v${version}/${tgz}" \
    -o "${tmp}/${tgz}"
  rc=$?
  if [[ "${rc}" -ne 0 ]]; then
    log "Multica download failed ($(explain_rc "${rc}"))"
    rm -rf "${tmp}"
    return 0
  fi
  expected="$(grep -F "  ${tgz}" "${tmp}/checksums.txt" | head -1 || true)"
  case "${expected}" in
    *"  ${tgz}") ;;
    *)
      log "Multica checksum entry missing for ${tgz}"
      rm -rf "${tmp}"
      return 0
      ;;
  esac
  if ! printf '%s\n' "${expected}" | (cd "${tmp}" && sha256sum -c -); then
    log "Multica checksum mismatch"
    rm -rf "${tmp}"
    return 0
  fi
  if ! tar -xzf "${tmp}/${tgz}" -C "${tmp}" || [[ ! -f "${tmp}/multica" ]]; then
    log "Multica archive missing binary"
    rm -rf "${tmp}"
    return 0
  fi
  if ! install -m 0755 "${tmp}/multica" /data/bin/multica; then
    log "Multica install to /data/bin failed"
    rm -rf "${tmp}"
    return 0
  fi
  install -m 0755 "${tmp}/multica" /usr/local/bin/multica \
    || log "Multica install to /usr/local/bin failed (non-fatal)"
  rm -rf "${tmp}"
  log "Multica ${version} installed ($(/data/bin/multica version 2>/dev/null | head -1 || echo unknown))"
}

update_claude() {
  log "Updating Claude Code…"
  local version checksum url tmp installed rc
  version="$(run_timeout 60 curl -fsSL https://downloads.claude.ai/claude-code-releases/latest)" || {
    log "could not resolve Claude latest version"
    return 0
  }
  version="${version//$'\r'/}"
  version="${version//[[:space:]]/}"
  installed="$(claude_installed_version || true)"
  log "Claude installed=${installed:-none} latest=${version}"
  if [[ -n "${installed}" && "${installed}" == "${version}" ]]; then
    log "Claude already at ${installed}; skip"
    return 0
  fi
  checksum="$(run_timeout 60 curl -fsSL "https://downloads.claude.ai/claude-code-releases/${version}/manifest.json" \
    | jq -r --arg p "${CLAUDE_PLATFORM}" '.platforms[$p].checksum // empty')" || true
  if [[ -z "${checksum}" ]]; then
    log "no Claude checksum for ${CLAUDE_PLATFORM} in ${version}"
    return 0
  fi
  tmp="$(mktemp)"
  url="https://downloads.claude.ai/claude-code-releases/${version}/${CLAUDE_PLATFORM}/claude"
  log "Claude download ${version} (timeout 600s)…"
  run_timeout 600 curl -fsSL "${url}" -o "${tmp}"
  rc=$?
  if [[ "${rc}" -ne 0 ]]; then
    log "Claude download failed ($(explain_rc "${rc}"))"
    rm -f "${tmp}"
    return 0
  fi
  if ! echo "${checksum}  ${tmp}" | sha256sum -c -; then
    log "Claude checksum mismatch"
    rm -f "${tmp}"
    return 0
  fi
  if ! install -m 0755 "${tmp}" /data/bin/claude; then
    log "Claude install to /data/bin failed"
    rm -f "${tmp}"
    return 0
  fi
  install -m 0755 "${tmp}" /usr/local/bin/claude \
    || log "Claude install to /usr/local/bin failed (non-fatal)"
  rm -f "${tmp}"
  log "Claude Code ${version} installed ($(/data/bin/claude --version 2>/dev/null | head -1 || echo unknown))"
}

update_cursor() {
  log "Updating Cursor Agent…"
  # Official installer places agent under $HOME/.local; use /data so it persists.
  local old_home="${HOME:-}" rc
  export HOME=/data
  run_timeout 180 bash -c 'curl -fsS https://cursor.com/install | bash'
  rc=$?
  if [[ "${rc}" -eq 0 ]]; then
    if [[ -x /data/.local/bin/cursor-agent ]]; then
      ln -sfn /data/.local/bin/cursor-agent /data/bin/cursor-agent
      ln -sfn /data/.local/bin/agent /data/bin/agent
      ln -sfn /data/.local/bin/cursor-agent /usr/local/bin/cursor-agent
      ln -sfn /data/.local/bin/agent /usr/local/bin/agent
    fi
    log "Cursor Agent updated ($(cursor-agent --version 2>/dev/null || agent --version 2>/dev/null || echo unknown))"
  else
    log "Cursor Agent update failed ($(explain_rc "${rc}")) (non-fatal)"
  fi
  export HOME="${old_home}"
}

update_pi() {
  log "Updating Pi coding agent…"
  if ! command -v npm >/dev/null 2>&1; then
    log "npm missing; skip Pi update"
    return 0
  fi
  export npm_config_cache=/data/.npm
  export npm_config_prefix="${PI_PREFIX}"
  export npm_config_update_notifier=false
  export npm_config_fund=false
  export npm_config_audit=false
  export npm_config_loglevel="${NPM_LOGLEVEL:-info}"

  local installed latest rc started elapsed
  log "node=$(node -v 2>/dev/null || echo missing) npm=$(npm -v 2>/dev/null || echo missing) arch=${ARCH_RAW}"
  log_df

  installed="$(pi_prefix_version || true)"
  latest="$(run_timeout 60 npm view @earendil-works/pi-coding-agent version 2>/dev/null || true)"
  latest="${latest//$'\r'/}"
  latest="${latest//[[:space:]]/}"
  log "Pi installed=${installed:-none} latest=${latest:-unknown} prefix=${PI_PREFIX}"

  if [[ -z "${latest}" ]]; then
    log "could not resolve latest Pi version from npm registry (network/DNS?)"
    run_timeout 15 curl -fsSI https://registry.npmjs.org/@earendil-works/pi-coding-agent >/dev/null \
      && log "npm registry HEAD ok" \
      || log "npm registry HEAD failed"
    return 0
  fi

  if [[ -n "${installed}" && "${installed}" == "${latest}" && -x "${PI_PREFIX}/bin/pi" ]]; then
    log "Pi already at ${installed}; skip npm install"
    link_pi
    return 0
  fi

  log "Pi ${installed:-none} → ${latest} (npm install --prefix ${PI_PREFIX}, timeout 900s)…"
  started="$(date +%s)"
  run_timeout 900 npm install -g --prefix "${PI_PREFIX}" --omit=dev --no-audit --no-fund \
    @earendil-works/pi-coding-agent@latest
  rc=$?
  elapsed="$(( $(date +%s) - started ))"
  log "Pi npm install finished after ${elapsed}s ($(explain_rc "${rc}"))"

  if [[ "${rc}" -eq 0 ]]; then
    link_pi
    log "Pi updated ($(${PI_PREFIX}/bin/pi --version 2>/dev/null || echo unknown))"
    return 0
  fi

  log "Pi update failed (non-fatal); previous pi remains available"
  log_df
  tail_npm_log
}

update_multica
update_claude
update_cursor
update_pi
log "done"
