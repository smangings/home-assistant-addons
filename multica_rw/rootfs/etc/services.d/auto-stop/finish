#!/command/with-contenv bash
# s6-overlay legacy services.d: exit 0 from finish => restart service;
# non-zero => do not restart.
#
# One-shot timer. Restarting this service would open another full window.
exit_code="${1:-0}"
if [[ "${exit_code}" -eq 256 ]]; then
  exit_code=$((128 + ${2:-0}))
fi
echo "[multica-auto-stop] service ended (${exit_code}); not restarting"
exit 1
