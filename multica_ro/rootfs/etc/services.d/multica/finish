#!/command/with-contenv bash
# s6 finish semantics: exit 125 marks the service permanently down (no
# restart); any other exit code restarts it. (Earlier versions used exit 1
# here, which s6 treats as "restart" — config failures looped.)
#
# Restart only on unexpected crashes. Permanent config/auth failures use
# exit 78 (EX_CONFIG) from /run.sh, and a clean exit 0 means the daemon is
# intentionally parked (e.g. no multica_token); neither must loop.
exit_code="${1:-0}"
if [[ "${exit_code}" -eq 256 ]]; then
  exit_code=$((128 + ${2:-0}))
fi

if [[ "${exit_code}" -eq 0 ]]; then
  echo "[multica] clean exit; not auto-restarting (Supervisor owns lifecycle)"
  exit 125
fi

if [[ "${exit_code}" -eq 78 ]]; then
  echo "[multica] configuration/auth failure (exit 78); not restarting — fix add-on options and restart"
  exit 125
fi

# Keep under s6's ~5s finish timeout.
echo "[multica] service crashed with exit ${exit_code}; restarting in 3s"
sleep 3
exit 0
