#!/usr/bin/env bash
# Thin wrapper around Home Assistant Core API via the Supervisor proxy.
# Usage: ha-api METHOD PATH [curl args...]
set -euo pipefail

METHOD="${1:-}"
PATH_PART="${2:-}"
shift $(( $# > 0 ? 1 : 0 ))
shift $(( $# > 0 ? 1 : 0 )) || true

if [[ -z "${METHOD}" || -z "${PATH_PART}" ]]; then
  echo "Usage: ha-api METHOD PATH [extra curl args...]" >&2
  echo "  ha-api GET /states" >&2
  echo "  ha-api GET '/history/period/2026-07-29T00:00:00+00:00?filter_entity_id=sun.sun'" >&2
  exit 2
fi

METHOD_UPPER="$(printf '%s' "${METHOD}" | tr '[:lower:]' '[:upper:]')"
if [[ "${MULTICA_ACCESS_MODE:-}" == "ro" ]]; then
  blocked=""
  if [[ "${METHOD_UPPER}" != "GET" && "${METHOD_UPPER}" != "HEAD" ]]; then
    blocked="${METHOD_UPPER}"
  fi
  # Extra curl arguments come after -X, and curl uses the last method and any
  # body it is given, so they could turn a GET into a write.
  for arg in "$@"; do
    case "${arg}" in
      -X*|--request|--request=*|-d*|--data*|--json*|-F*|--form*|-T*|--upload-file*)
        blocked="curl option ${arg}" ;;
    esac
  done
  if [[ -n "${blocked}" ]]; then
    echo "ha-api: write requests are blocked in the read-only Agent Host add-on (${blocked})" >&2
    echo "ha-api: note: SUPERVISOR_TOKEN is still present — filesystem RO does not revoke Core API rights" >&2
    exit 1
  fi
fi

TOKEN="${HA_TOKEN:-${SUPERVISOR_TOKEN:-}}"
BASE="${HA_URL:-http://supervisor/core/api}"
BASE="${BASE%/}"
PATH_PART="/${PATH_PART#/}"

if [[ -z "${TOKEN}" ]]; then
  echo "ha-api: SUPERVISOR_TOKEN / HA_TOKEN is not set" >&2
  exit 1
fi

exec curl -fsS \
  -X "${METHOD_UPPER}" \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  "$@" \
  "${BASE}${PATH_PART}"
