#!/command/with-contenv bash
# s6 longrun: ingress web terminal. ttyd only listens on a unix socket;
# nginx (services.d/nginx) is the sole TCP listener and only admits the
# Supervisor ingress proxy. tmux keeps a login in progress alive if the
# browser panel is closed and reopened.
set -uo pipefail
# shellcheck source=/dev/null
source /usr/lib/agent-host/common.sh
ah_backoff terminal "" 5
rm -f /run/ttyd.sock
exec ttyd \
  --writable \
  --interface /run/ttyd.sock \
  --ping-interval 30 \
  --max-clients 4 \
  --terminal-type xterm-256color \
  --client-option titleFixed="Agent Host $(ah_mode_label)" \
  tmux -u new-session -A -s agent-host /usr/bin/claude-rc-terminal
